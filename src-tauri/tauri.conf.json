{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NTE Tracker",
  "version": "1.2.3",
  "identifier": "com.ntetracker.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "NTE Tracker",
        "label": "main",
        "width": 1430,
        "height": 930,
        "minWidth": 900,
        "minHeight": 650,
        "backgroundColor": "#090d18"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://www.ntegame.com https://cdn.prydwen.gg; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCQTdBRjBDRjc1MEFGRDYKUldUV3IxRDNESytudXkvSHFWblQ3emFKM0ZUV0RncDF4U1ZCZFZmcjF6MFE5OEU1cndwcHcrYWkK",
      "endpoints": [
        "https://github.com/MrDustyBowl/NTE-Tracker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
