{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "NTE Tracker",
    "version":  "1.1.0",
    "identifier":  "com.ntetracker.desktop",
    "build":  {
                  "frontendDist":  "../dist",
                  "devUrl":  "http://localhost:1420",
                  "beforeDevCommand":  "npm run dev",
                  "beforeBuildCommand":  "npm run build"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "NTE Tracker",
                                    "label":  "main",
                                    "width":  1430,
                                    "height":  930,
                                    "minWidth":  900,
                                    "minHeight":  650,
                                    "backgroundColor":  "#090d18"
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; img-src \u0027self\u0027 data:; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; connect-src ipc: http://ipc.localhost; script-src \u0027self\u0027"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.ico"
                            ],
                   "createUpdaterArtifacts":  true
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCQTdBRjBDRjc1MEFGRDYKUldUV3IxRDNESytudXkvSHFWblQ3emFKM0ZUV0RncDF4U1ZCZFZmcjF6MFE5OEU1cndwcHcrYWkK",
                                    "endpoints":  [
                                                      "https://github.com/MrDustyBowl/NTE-Tracker/releases/latest/download/latest.json"
                                                  ],
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                }
                }
}